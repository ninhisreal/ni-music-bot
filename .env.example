# ========== BẮT BUỘC (REQUIRED) ==========
# 1. Token của Bot Discord
DISCORD_TOKEN=your_bot_token_here

# 2. Application ID / Client ID
CLIENT_ID=your_client_id_here

# 3. Máy chủ được chỉ định duy nhất (Server Studio)
ALLOWED_GUILD_ID=1250455464336949278

# ========== TÙY CHỌN (OPTIONAL) ==========
# ID tài khoản Discord của bạn (Owner)
OWNER_ID=1059774801968902184

# Prefix mặc định
PREFIX=ni!

# Ngôn ngữ mặc định (vi: Tiếng Việt, en: Tiếng Anh)
DEFAULT_LANGUAGE=vi

# Log level (info | debug | warn | error)
LOG_LEVEL=info
